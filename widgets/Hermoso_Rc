#Conky By Jesse Avalos See me on Eye candy Linux (Google +) for more conkys.
#
# NOTE ON SIZING: see the header of conkyrc_time.  Every dimension here is the
# original 1080p value divided by the GNOME text-scaling-factor (1.1), because
# conky scales everything it reads by Xft.dpi/96.
#
background yes
update_interval 1

cpu_avg_samples 2
net_avg_samples 2
temperature_unit celsius

double_buffer yes
no_buffers yes
text_buffer_size 2048

# xinerama_head 0 = built-in eDP panel, 1 = external HDMI monitor.
xinerama_head 0
alignment top_middle
gap_x 409
gap_y 91
minimum_size 500 500
maximum_width 500

own_window yes
own_window_type normal
own_window_transparent yes
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
own_window_argb_visual yes
own_window_argb_value 0

border_inner_margin 0
border_outer_margin 0

draw_shades no
draw_outline no
draw_borders no
draw_graph_borders no
default_shade_color 112422

override_utf8_locale yes
use_xft yes
xftfont Feena Casual:size=9
xftalpha 1
uppercase yes

default_color D6D5D4
#b5c23e
own_window_colour 000000
TEXT


${font Anurati:size=58}${color D6D5D4}${time %A}
