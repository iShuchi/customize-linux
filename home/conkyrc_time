# Conky settings #
#
# NOTE ON SIZING (GNOME + fractional scaling, X11):
#   This is a template.  The __NAME__ placeholders are filled in by ./script
#   each time it starts conky, from ratios of the screen the clock sits on,
#   so the clock keeps its size and place relative to any screen.  Change the
#   ratios in ./script, not the numbers here.
#   conky multiplies EVERY dimension it reads -- gap_x/gap_y, offset/voffset,
#   minimum_size, border margins and "size=" fonts -- by Xft.dpi/96, which is
#   why ./script works in screen pixels * 96 / Xft.dpi.
#   "pixelsize=" is NOT scaled by conky, so this file uses "size=" throughout.
#
background no
update_interval 30
double_buffer yes
no_buffers yes

# Window specifications #
own_window yes
own_window_type normal
own_window_hints undecorated,below,sticky,skip_taskbar,skip_pager
own_window_title 
own_window_colour 000000
own_window_argb_visual yes
own_window_argb_value 0

minimum_size 0 0

# Alignment #
# The screen is picked with CLOCK_HEAD in ./script.
xinerama_head __HEAD__
alignment top_left
gap_x __GAP_X__
gap_y __GAP_Y__

border_inner_margin __MARGIN__
border_outer_margin 0

# Graphics settings #
draw_shades no
draw_outline no
draw_borders no
draw_graph_borders no

# Text settings #
use_xft yes
xftalpha 0
xftfont JosefinSans-Regular:size=14

# Color scheme #
default_color ffffff

color1 e03f3f
color2 9933CC
color3 669900
color4 FF8800
color5 CC0000
color6 AAAAAA
color7 DDDDDD

own_window_transparent yes
TEXT
${voffset __VOFF_TOP__}${font JosefinSans-Regular:size=__TIME_SIZE__}${time %I:%M}${font JosefinSans-Regular:size=__PM_SIZE__}${time %P}$font

${font JosefinSans-Regular:size=__DATE_SIZE__}${time %A} ${color1}${time %d}$color ${time %B} ${time %Y}$font
${voffset __VOFF_END__}
